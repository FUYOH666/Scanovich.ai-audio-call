# Шаблон переменных окружения для ASR-4.5
# Скопируйте в .env и заполните реальными значениями

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Google Sheets Integration
GOOGLE_CREDENTIALS_PATH=./credentials/google_credentials.json
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# VLLM Server Configuration (если используется внешний сервер)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=your_api_key_if_needed

# Database Configuration (если используется внешняя БД)
DATABASE_URL=sqlite:///./analytics/analytics.db

# Logging Level
LOG_LEVEL=INFO

# Performance Settings
MAX_WORKERS=1
BATCH_SIZE=1

# Security Settings (если нужны дополнительные ограничения)
ALLOWED_HOSTS=localhost,127.0.0.1
SECRET_KEY=your_secret_key_for_sessions_if_needed

# ======================================================================
# ⚠️ ВАЖНЫЕ ПРАВИЛА:
# ======================================================================
#
# 1. НИКОГДА не публикуйте .env файл в GitHub
# 2. Добавьте .env в .gitignore (уже добавлено)
# 3. Используйте разные .env файлы для разных окружений:
#    - .env.development (для разработки)
#    - .env.production (для продакшена)
#    - .env.testing (для тестирования)
#
# 4. В продакшене используйте:
#    - Системные переменные окружения (export TELEGRAM_BOT_TOKEN=...)
#    - Docker секреты
#    - Kubernetes секреты
#    - CI/CD переменные
#
# 5. Проверяйте безопасность:
#    - git status --ignored (убедитесь, что .env игнорируется)
#    - ls -la | grep .env (файл не должен быть виден в репозитории)
#
# ======================================================================