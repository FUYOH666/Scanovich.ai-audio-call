# ⭐ ASR-4.5 Environment Variables Example
# Скопируйте этот файл в .env и заполните значения

# VLLM API Configuration
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=models/Qwen3-30B-A3B-Instruct-2507-AWQ-4bit

# OpenRouter API (для анализа качества через Claude Sonnet 4.5)
OPENROUTER_API_KEY=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

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# GPU Device Index (0 for first GPU)
GPU_DEVICE=0

# Paths (опционально, переопределяют config.yaml)
# INPUT_PATH=./input
# OUTPUT_PATH=./output
# ARCHIVE_PATH=./archive

