# Environment template — Call Analytics Platform
# Copy to .env for local development only. Keep real secrets out of git.

# Logging
LOGGING__LEVEL=INFO

# Optional remote OpenAI-compatible LLM endpoint
VLLM__ENABLED=true
VLLM__BASE_URL=http://localhost:8000/v1
VLLM__MODEL=your-served-model-name

# Optional quality-analysis provider overrides
QUALITY_ANALYSIS__ENABLED=true
QUALITY_ANALYSIS__PROVIDER=vllm
QUALITY_ANALYSIS__BASE_URL=http://localhost:8000/v1
QUALITY_ANALYSIS__MODEL=your-served-model-name
QUALITY_ANALYSIS__API_KEY_ENV=OPENROUTER_API_KEY

# Paths
PATHS__INPUT=./input
PATHS__OUTPUT=./output
PATHS__METADATA=./metadata
PATHS__ARCHIVE=./archive
PATHS__LOGS=./logs

# Demo / pilot web layer
WEB__HOST=127.0.0.1
WEB__PORT=8080
WEB__REQUIRE_API_KEY=false
WEB__API_KEY=<SET_FOR_PROTECTED_PILOT_DEPLOYS>

# Optional Google Sheets / Telegram overrides
GOOGLE_SHEETS__ENABLED=false
GOOGLE_SHEETS__CREDENTIALS_PATH=./credentials/google_credentials.json
GOOGLE_SHEETS__SPREADSHEET_ID=your_spreadsheet_id_here
ANALYTICS__TELEGRAM__ENABLED=false
ANALYTICS__TELEGRAM__BOT_TOKEN=<REPLACE_WITH_YOUR_BOT_TOKEN>
ANALYTICS__TELEGRAM__CHAT_ID=your_chat_id_here

# ======================================================================
# ⚠️ ВАЖНЫЕ ПРАВИЛА:
# ======================================================================
#
# 1. НИКОГДА не публикуйте .env файл в GitHub
# 2. Добавьте .env в .gitignore (уже добавлено)
# 3. Используйте разные .env файлы для разных окружений:
#    - .env.development (для разработки)
#    - .env.production (для продакшена)
#    - .env.testing (для тестирования)
#
# 4. В продакшене используйте:
#    - Системные переменные окружения (export TELEGRAM_BOT_TOKEN=...)
#    - Docker секреты
#    - Kubernetes секреты
#    - CI/CD переменные
#
# 5. Проверяйте безопасность:
#    - git status --ignored (убедитесь, что .env игнорируется)
#    - ls -la | grep .env (файл не должен быть виден в репозитории)
#
# ======================================================================