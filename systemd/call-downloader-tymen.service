[Unit]
Description=Call Records Downloader - Rostelecom Tymen
Documentation=https://github.com/FUYOH666/Scanovich.ai-audio-call
After=network.target

[Service]
Type=simple
User=ai
Group=ai
WorkingDirectory=/home/ai/Документы/ScanovichAI/Calls-downloader/rostelecom-Tymen
Environment="PATH=/home/ai/Документы/ScanovichAI/Calls-downloader/rostelecom-Tymen/venv/bin:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"

ExecStart=/home/ai/Документы/ScanovichAI/Calls-downloader/rostelecom-Tymen/venv/bin/python call_records_watcher.py

# Автоматический рестарт при падении
Restart=always
RestartSec=10

# Graceful shutdown
TimeoutStopSec=30

# Логирование
StandardOutput=journal
StandardError=journal
SyslogIdentifier=call-downloader-tymen

[Install]
WantedBy=multi-user.target

