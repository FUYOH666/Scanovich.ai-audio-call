[Unit]
Description=VLLM Server - LLM-Model для ASR-4.5
Documentation=https://github.com/ASR Call Quality Analyzer/ASR-4.5
After=network.target

[Service]
Type=simple
User=ai
Group=ai
WorkingDirectory=/home/ai/Документы/vLLm
Environment="PATH=/home/ai/Документы/vLLm/venv/bin:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="CUDA_VISIBLE_DEVICES=0"

ExecStart=/home/ai/Документы/vLLm/venv/bin/python -m vllm.entrypoints.openai.api_server \
    --model models/your-llm-model \
    --dtype float16 \
    --max-model-len 16384 \
    --tensor-parallel-size 1 \
    --gpu-memory-utilization 0.8 \
    --max-num-seqs 1 \
    --host 0.0.0.0 \
    --port 8000

# Автоматический рестарт при падении
Restart=always
RestartSec=30

# Graceful shutdown (даём 60 секунд на завершение)
TimeoutStopSec=60

# Логирование
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vllm

# Ограничения ресурсов
# MemoryLimit=30G  # Раскомментируй если нужно

[Install]
WantedBy=multi-user.target

